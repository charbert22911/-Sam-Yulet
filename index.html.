<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Samuel & Yulet | Nuestra Boda</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- PANTALLA DE BIENVENIDA -->
    <section id="inicio" class="pantalla">

        <div class="capa"></div>

        <div class="contenido">

            <h1 class="titulo">
                Samuel & Yulet
            </h1>

            <p id="textoIdioma" class="subtitulo">
                Por favor, selecciona el idioma en el que deseas leer nuestra invitación.
            </p>

            <div class="idiomas">

                <button onclick="cambiarIdioma('es')">
                    🇲🇽 Español
                </button>

                <button onclick="cambiarIdioma('en')">
                    🇺🇸 English
                </button>

            </div>

        </div>

    </section>

    <!-- INVITACIÓN -->
    <main id="invitacion" style="display:none;">

        <!-- VERSÍCULO -->
        <section class="seccion">

            <h2 id="tituloVersiculo">
                Eclesiastés 3:1
            </h2>

            <p id="versiculo">
                Todo tiene su tiempo, y todo lo que se quiere debajo del cielo tiene su hora.
            </p>

        </section>

        <!-- BIENVENIDA -->
        <section class="seccion">

            <h2 id="tituloBienvenida">
                Bienvenidos
            </h2>

            <p id="bienvenida">
                Nos encantaría compartir este momento tan especial contigo.
            </p>

        </section>

        <!-- CUENTA REGRESIVA -->
        <section class="seccion">

            <h2 id="tituloCuenta">
                Faltan...
            </h2>

            <div id="contador">

                <div>
                    <span id="dias">0</span>
                    <small id="txtDias">Días</small>
                </div>

                <div>
                    <span id="horas">0</span>
                    <small id="txtHoras">Horas</small>
                </div>

                <div>
                    <span id="minutos">0</span>
                    <small id="txtMinutos">Minutos</small>
                </div>

                <div>
                    <span id="segundos">0</span>
                    <small id="txtSegundos">Segundos</small>
                </div>

            </div>

        </section>

        <!-- NUESTRO GRAN DÍA -->
        <section class="seccion">

            <h2 id="tituloEvento">
                Nuestro Gran Día
            </h2>

            <p id="mensajeEvento">
                Acompáñanos a celebrar el inicio de nuestra historia juntos.
                Damos gracias a Dios por permitirnos llegar hasta este momento
                y nos alegrará mucho contar con tu presencia.
            </p>

            <div class="tarjeta">

                <p>📅 <strong>Sábado 14 de noviembre de 2026</strong></p>

                <p>🕐 <strong>1:00 p. m.</strong></p>

                <p>📍 <strong>Salón Jireh</strong></p>

                <p>📌 Av. Amapolas 31 y 32</p>

            </div>

            <a
                id="btnMapa"
                class="boton"
                href="https://maps.app.goo.gl/CFgEuXM1NWK9kGJ4A?g_st=ic"
                target="_blank">

                Ver ubicación

            </a>

            <a
                id="btnWhatsapp"
                class="boton boton-secundario"
                href="https://chat.whatsapp.com/EX8RsBydihEFHcXHEk8LY9?s=cl&p=i&ilr=2"
                target="_blank">

                Confirmar asistencia

            </a>

            <p id="fechaLimite">
                Fecha límite para confirmar:
                <strong>2 de octubre de 2026</strong>
            </p>

        </section>

        <!-- GALERÍA -->
        <section class="seccion">

            <h2 id="tituloGaleria">
                Nuestra Historia
            </h2>

            <div class="galeria">

                <div class="foto">
                    Próximamente fotografía 1
                </div>

                <div class="foto">
                    Próximamente fotografía 2
                </div>

                <div class="foto">
                    Próximamente fotografía 3
                </div>

            </div>

        </section>

        <!-- DESPEDIDA -->
        <section class="seccion">

            <h2 id="tituloFinal">
                Gracias
            </h2>

            <p id="mensajeFinal">
                Que Dios bendiga tu vida y tu familia.
                Será un honor compartir este día contigo.
            </p>

        </section>

    </main>

    <script src="script.js"></script>

</body>

</html>
